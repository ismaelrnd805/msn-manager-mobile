APP_NAME="MSN Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://serveur.msn.mg

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base centrale PostgreSQL (les clients n'y accèdent JAMAIS directement)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=msn
DB_USERNAME=msn_app
DB_PASSWORD=CHANGEZ_MOI

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum : jetons d'accès courts (8h) gérés par le code ; voir app/Providers
SANCTUM_STATEFUL_DOMAINS=serveur.msn.mg
